# Standalone / development settings (the Home Assistant App gets these from the Supervisor).
TZ=Europe/Tallinn
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token
EMHASS_LENS_LOG_LEVEL=info
# true = the web UI can't change anything (use when the port is reachable by others)
EMHASS_LENS_READ_ONLY=false
